# 复制为 .env 后填写。切勿提交 .env。

# ---- 应用 ----
APP_ENV=development
APP_SECRET_KEY=change-me
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# ---- 数据库 ----
POSTGRES_USER=growth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=growth_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://growth:change-me@localhost:5432/growth_agent

# ---- Redis(会话 / 队列)----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---- 模型 ----
# 走 openJiuwen 编排层。接入方式待定,见 docs/06-AGENT-DESIGN.md
OPENJIUWEN_BASE_URL=
OPENJIUWEN_API_KEY=
LLM_API_KEY=
LLM_MODEL=
AGENT_MAX_TOKENS=4096

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 移动端 ----
MOBILE_API_BASE_URL=http://10.0.2.2:8000
