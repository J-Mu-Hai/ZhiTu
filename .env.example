# 复制为 .env 后填写。切勿提交 .env(.gitignore 已忽略)。
#
# 本文件必须与实际读取它的代码一致。把不存在的能力写在这里,后果不是"文档不准",
# 而是照着它配置的人会以为某件事已经接好了。

# ---- 应用 ----
APP_ENV=development
APP_SECRET_KEY=change-me
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---- 数据库 ----
# 留空 = 使用仓库内的 SQLite(data/zhitu_dev.db),本地开发用这个,不需要装任何数据库。
# 注意:上面那些 POSTGRES_* 变量**当前没有任何代码读取**,它们只是给部署时拼连接串用的
# 备忘,留在这里是因为线上要用 PostgreSQL。本地把它们当注释看即可。
DATABASE_URL=
#
# 线上(腾讯云 PostgreSQL)示例,把上面那行注释掉、启用这一行:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

POSTGRES_USER=growth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=growth_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- 缓存的取舍 ----
# Redis **已从依赖中移除**,当前没有任何代码使用它。登录限流与熔断做成进程内实现
# (每个 worker 各一份,这一点会在文档里如实标注)。等真的需要跨 worker 共享状态时
# 再把 REDIS_URL 加回来,不要提前引入一个连不上的基础设施。
# REDIS_URL=redis://localhost:6379/0

# ---- 模型 ----
# OpenJiuwen 不是独立服务,**没有 base_url / api_key**。它是本地 Python SDK
# (包名 openjiuwen),直接复用下面的 LLM_API_KEY 去调 DeepSeek。这两行曾经出现在
# 这里但从未落地过,现在删掉,免得让人以为要单独申请一套凭证。
LLM_API_KEY=
# DeepSeek 官方只有 deepseek-chat 与 deepseek-reasoner。
# 曾经这里默认填的是 deepseek-flash —— 那不是官方模型名,真实调用必然失败。
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com
# 一次规划回复的 token 上限。一份"三个月计划"实测要 1500-2500,给到 4096 会在
# 更长的计划上截断 JSON,那一整轮就作废了。别往下调。
AGENT_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=30

# 规划调用的实现路径:auto | openjiuwen | direct_llm | rule
# auto = 每次请求探测 openjiuwen 是否可用,不可用则降级,并在响应里如实标注
# (degraded / degradedReason),绝不假装是模型生成的。
AGENT_REASONER=auto

# ---- 公开研究(默认关闭) ----
# AI 只能研究**公开、可验证**的信息(学校政策/申请截止/比赛规则/公开课程…)。
# 默认不发任何请求;未配置时工具会如实返回"未配置",不会编造来源。
RESEARCH_ENABLED=false
# 空 / none = 禁止联网;首期只支持 tavily。
RESEARCH_PROVIDER=none
# 仅当 RESEARCH_PROVIDER=tavily 时需要;只会用于请求,不会进 API/UI/日志。
TAVILY_API_KEY=
RESEARCH_MAX_CALLS_PER_TURN=1
RESEARCH_MAX_RESULTS=3
RESEARCH_TIMEOUT_SECONDS=6
RESEARCH_MAX_QUERY_CHARS=180
RESEARCH_MAX_CALLS_PER_DAY=100
RESEARCH_CACHE_TTL_SECONDS=86400
RESEARCH_TIMEZONE=Asia/Shanghai
# 可选:逗号分隔的域名子串白名单;空 = 不限制(仍只访问公开网页)。
RESEARCH_ALLOWED_DOMAINS=

# ---- 前端 ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 移动端 ----
MOBILE_API_BASE_URL=http://10.0.2.2:8000
